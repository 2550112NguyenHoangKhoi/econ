namespace Telemetry;

table ZoneData {
  id: string;
  temp: float;
  occupants: int;
  load: float;
  lightsOn: bool = true;  // appended field (backward-compatible); actuated lighting state
  humidity: float = 0;    // appended: measured %RH from a bound sensor (0 = none reporting)
  co2: float = 0;         // appended: measured ppm from a bound NDIR sensor (0 = none)
  plugW: float = 0;       // appended: plug-load draw in W (measured clamp if bound, else model)
  plugShed: bool = false; // appended: non-critical sockets currently swept off by the APLC
  // Supply-air temperature the cooling law actually used for THIS zone this tick. The
  // dashboard needs it to compute delivered cooling Q = rho*V*cp*(Troom - Tsupply); it
  // used to hardcode 12.0 degC, which stopped being true the moment a DS18B20 probe could
  // supersede the design value per zone. supplyReal says which it is, so a modelled figure
  // never travels on a channel that implies it was measured.
  supplyC: float = 0;       // appended: degC, 0 = engine reported none
  supplyReal: bool = false; // appended: true only when a live probe measured it
  stripW: float = 0;
  // Demand-controlled ventilation, per zone. ventFloor is the damper position this zone's
  // FRESH-AIR demand requires, in [0,1] -- distinct from the thermal demand, because the
  // damper serves both and runs at whichever is larger. ventMeasured says whether a live
  // NDIR reading produced it: false means ventFloor is the fixed ASHRAE minimum and nothing
  // about it was demand-controlled. A UI that shows ventFloor without ventMeasured would
  // present a constant as a measurement.
  ventFloor: float = 0;        // appended
  ventMeasured: bool = false;  // appended        // appended: measured power-strip draw in W (ACS712)
}

table VavData {
  id: string;
  airflow: float;
  damper: float;
}

table AhuData {
  id: string;
  supplyTemp: float;
  pressure: float;
  status: string;
  mode: string;
}

table GlobalData {
  buildingLoadMw: float;
  systemHealth: float;
  totalOccupants: int;
  coolingOutputMw: float;
  plantCop: float;
  energySavedMw: float;
  bessDischargeMw: float = 0;  // appended: + discharging to grid, - charging (0 = no BESS)
  bessSocPct: float = 0;       // appended: battery state of charge, 0..100; -1 = NO PACK
                               // FITTED. 0 is a state a real flat battery can be in, so
                               // absence needs its own impossible value.
  avgCo2: float = 0;           // appended: building CO2 ppm, real sensors preferred over the
                               // occupancy estimate — the engine picks, so every client agrees
  // Plug-load management (APLC). Plug loads are the end use a conventional BMS neither
  // meters nor controls — and the largest one in the Hanoi office case study this
  // project benchmarks against (26.4% of energy, Luong et al. 2025).
  plugKw: float = 0;           // appended: total plug draw right now (active + standby - shed)
  plugStandbyKw: float = 0;    // appended: the always-on phantom portion of plugKw
  plugShedKw: float = 0;       // appended: kW currently switched off by the after-hours sweep
  plugSavedKwh: float = 0;     // appended: cumulative energy the sweep has avoided
  // Autonomous optimizer (occupancy-driven setback). autoPilot is the engine's real
  // control flag, not a UI toggle: when false the optimizer is suspended and the
  // operator owns the setpoints. zonesInSetback is how many zones it is holding in
  // energy-saving setback right now — the real backing for the "autonomous action" cards.
  autoPilot: bool = true;      // appended
  zonesInSetback: int = 0;     // appended
  // AHU static pressure, Pa — the real output of the engine's Hardy-Cross network solve
  // (engine.go doHardyCross). It was computed every tick and never serialized, so the
  // topology view's AHU card showed a literal 500 Pa placeholder for the life of the
  // project. Zero means the solver has not run yet.
  ahuPressurePa: float = 0;    // appended
  // Demand-controlled ventilation (simulation/ventilation.go). dcvZones is how many zones
  // are having their damper positioned from a LIVE NDIR reading right now; a building with
  // no CO2 sensors reports 0 and the dashboard must say "not demand-controlled" rather than
  // implying a loop that is not running. dcvAvoidedKw is the fresh-air cooling load those
  // zones are NOT carrying because their measured CO2 permitted a lower damper than the
  // design occupancy rate -- it is only ever computed over measured zones, so it can be
  // shown as a saving without breaching rule 3.
  dcvZones: int = 0;           // appended
  dcvAvoidedKw: float = 0;     // appended
}

table SimState {
  timestamp: long;
  zones: [ZoneData];
  vavs: [VavData];
  ahus: [AhuData];
  global: GlobalData;
}

root_type SimState;
